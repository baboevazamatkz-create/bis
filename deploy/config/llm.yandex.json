{
  "providers": [
    {
      "name": "yandexgpt-lite",
      "kind": "openai_compat",
      "base_url": "https://llm.api.cloud.yandex.net/v1",
      "model": "gpt://${YANDEX_FOLDER_ID}/yandexgpt-lite/latest",
      "api_key_env": "YANDEX_API_KEY",
      "auth_scheme": "Api-Key",
      "max_sensitivity": "internal",
      "mask_pii": true,
      "temperature": 0.1,
      "timeout": 60
    },
    {
      "name": "yandexgpt",
      "kind": "openai_compat",
      "base_url": "https://llm.api.cloud.yandex.net/v1",
      "model": "gpt://${YANDEX_FOLDER_ID}/yandexgpt/latest",
      "api_key_env": "YANDEX_API_KEY",
      "auth_scheme": "Api-Key",
      "max_sensitivity": "internal",
      "mask_pii": true,
      "temperature": 0.2,
      "timeout": 120
    },
    {
      "name": "local-vision",
      "kind": "openai_compat",
      "base_url": "${BIS_VISION_URL:-http://localhost:11434/v1}",
      "model": "${BIS_VISION_MODEL:-llama3.2-vision}",
      "max_sensitivity": "confidential",
      "mask_pii": false,
      "temperature": 0.1,
      "timeout": 600,
      "capabilities": [
        "text",
        "vision"
      ]
    },
    {
      "name": "yandex-vision",
      "kind": "openai_compat",
      "base_url": "https://llm.api.cloud.yandex.net/v1",
      "model": "gpt://${YANDEX_FOLDER_ID}/qwen3.6-35b-a3b/latest",
      "api_key_env": "YANDEX_API_KEY",
      "auth_scheme": "Api-Key",
      "max_sensitivity": "internal",
      "mask_pii": false,
      "temperature": 0.1,
      "timeout": 180,
      "capabilities": [
        "text",
        "vision"
      ]
    },
    {
      "name": "offline",
      "kind": "offline",
      "max_sensitivity": "confidential"
    }
  ],
  "routes": {
    "route": [
      "yandexgpt-lite",
      "offline"
    ],
    "extract": [
      "yandexgpt-lite",
      "yandexgpt",
      "offline"
    ],
    "chat": [
      "yandexgpt",
      "yandexgpt-lite",
      "offline"
    ],
    "analysis": [
      "yandexgpt",
      "yandexgpt-lite",
      "offline"
    ],
    "verify": [
      "yandexgpt-lite",
      "offline"
    ],
    "default": [
      "yandexgpt",
      "yandexgpt-lite",
      "offline"
    ],
    "vision": [
      "yandex-vision",
      "local-vision",
      "offline"
    ],
    "executive_report": [
      "yandexgpt-lite",
      "offline"
    ],
    "executive_document": [
      "yandexgpt",
      "yandexgpt-lite",
      "offline"
    ],
    "project_reading": [
      "yandexgpt",
      "yandexgpt-lite",
      "offline"
    ]
  }
}
