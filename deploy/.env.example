# Скопируйте в deploy/.env и заполните.

BIS_ENV=prod
# Не короче 32 символов: openssl rand -hex 32
BIS_SECRET_KEY=
POSTGRES_PASSWORD=change-me
BIS_HTTP_PORT=8080
BIS_CORS_ORIGINS=["http://localhost:8080"]

# Эмбеддинги: hash — без модели (для пробы); openai_compat — сервер bge-m3 (профиль ai)
BIS_EMBEDDING_PROVIDER=hash
# BIS_EMBEDDING_PROVIDER=openai_compat
# BIS_EMBEDDING_URL=http://embeddings:80/v1
# BIS_EMBEDDING_MODEL=BAAI/bge-m3
# BIS_EMBEDDING_DIM=1024

# Ключи облачных моделей (используются в config/llm.json через api_key_env)
# GIGACHAT_AUTH_KEY=
# YANDEX_API_KEY=

# Локальная модель для профиля gpu
# LLM_MODEL=Qwen/Qwen2.5-32B-Instruct-AWQ
